# Copy this file to ".env" and fill in your own values. NEVER commit the real .env.
# Google Gemini — free key, no card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=4000
# "*" lets the Android app / other devices on your network connect. Set a specific
# URL (or comma-separated list) to restrict access.
CLIENT_ORIGIN=*
# Optional: use any other OpenAI-compatible provider instead (Groq, OpenRouter, …):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
